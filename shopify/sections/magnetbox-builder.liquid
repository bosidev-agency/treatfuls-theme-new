    { "type": "range", "id": "spreads_required", "label": "Anzahl Spreads pro Box", "min": 0, "max": 5, "step": 1, "default": 1 },
    { "type": "product_list", "id": "bar_products", "label": "Wählbare Riegel (1er-Produkte)", "limit": 30 },
    { "type": "product_list", "id": "spread_products", "label": "Wählbare Spreads (1er-Produkte)", "limit": 15 }, { "type": "product_list", "id": "stock_products", "label": "Bestandsanzeige (Noch X verfügbar) bei", "info": "Nur für Produkte aus den Listen oben mit verfolgtem Bestand", "limit": 10 },
    { "type": "checkbox", "id": "include_box_component", "label": "Magnetbox selbst als Bestandteil mitbuchen", "info": "Zieht 1 Hart Cover Magnet Box vom Bestand ab und zeigt sie im Auftrag/Lieferschein.", "default": true },
    { "type": "header", "content": "Spruch" },
