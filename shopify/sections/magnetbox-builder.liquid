    { "type": "paragraph", "content": "Die Sprüche legst du als Blöcke „Spruch“ an." },
    { "type": "checkbox", "id": "show_no_phrase", "label": "Option „Ohne Spruch“ anzeigen", "default": true },
    { "type": "text", "id": "no_phrase_label", "label": "Text der Option im Shop", "default": "Ohne Spruch" },
    { "type": "text", "id": "no_phrase_value", "label": "So steht es im Auftrag/Lieferschein", "default": "Ohne Spruch" },
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Stell dir deine Magnetbox zusammen" },
    { "type": "text", "id": "phrase_heading", "label": "Schritt 1", "default": "1. Wähle deinen Spruch" },
    { "type": "text", "id": "spread_heading", "label": "Schritt 2", "default": "2. Wähle [anzahl] Spread", "info": "[anzahl] wird durch die Anzahl ersetzt" },
    { "type": "text", "id": "bar_heading", "label": "Schritt 3", "default": "3. Wähle [anzahl] Riegel" }, { "type": "text", "id": "tl_spread_label", "label": "Fortschrittsleiste: Bezeichnung Schritt 2", "default": "Spread/Tasse" },
    { "type": "text", "id": "summary_heading", "label": "Zusammenfassung", "default": "Deine Magnetbox" },
    { "type": "select", "id": "after_add", "label": "Nach dem Hinzufügen", "options": [ { "value": "cart", "label": "Zum Warenkorb" }, { "value": "checkout", "label": "Direkt zum Checkout" } ], "default": "cart" },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "background_color", "label": "Hintergrund", "default": "#c081a9" },
    { "type": "color", "id": "text_on_bg_color", "label": "Textfarbe auf dem Hintergrund", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Akzent (Plus/Minus, Rahmen, Zähler)", "default": "#e35478" },
    { "type": "color", "id": "card_color", "label": "Kartenfarbe", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Textfarbe auf Karten", "default": "#000000" }, { "type": "header", "content": "Info-Symbol" }, { "type": "paragraph", "content": "Der Info-Text kommt aus dem Produkt-Metafeld „Magnetbox Info-Text“. Ohne Text kein Symbol." }, { "type": "color", "id": "info_circle_color", "label": "Kreisfarbe", "default": "#e35478" }, { "type": "color", "id": "info_icon_color", "label": "Farbe des i", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "phrase",
      "name": "Spruch",
      "settings": [
        { "type": "text", "id": "text", "label": "Spruch" },
        { "type": "image_picker", "id": "image", "label": "Sticker-Bild (optional)" }
      ]
    }
  ],
  "presets": [ { "name": "Magnetbox Konfigurator" } ]
}
