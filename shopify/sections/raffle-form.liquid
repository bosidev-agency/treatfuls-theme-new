<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background_color != 'rgba(0,0,0,0)' and section.settings.background_color != blank -%}
      --section-background-color: {{ section.settings.background_color }};
    {%- endif -%}
    {%- if section.settings.accent_color != 'rgba(0,0,0,0)' and section.settings.accent_color != blank -%}
      --section-accent-color: {{ section.settings.accent_color }};
    {%- endif -%}
    {%- if section.settings.hover_color != 'rgba(0,0,0,0)' and section.settings.hover_color != blank -%}
      --section-hover-color: {{ section.settings.hover_color }};
    {%- endif -%}
  }
</style>

<section
  class="raffle-form"
  data-section-id="{{- section.id -}}"
  data-section-type="raffle-form"
>
  <div class="content-wrapper">
    <div class="container container--lg">
      <raffle-form
        {% if section.settings.post_success_anchor != blank %}
          data-post-success-anchor="{{ section.settings.post_success_anchor }}"
        {% endif %}
      >
        <div class="title-wrapper raffle-form__success-message hidden">
          <div class="form-message form-message--success">
            {% if section.settings.post_success_title != blank %}
              <h2 class="form-message__title title-bg">{{ section.settings.post_success_title }}</h2>
            {% endif %}
            {% if section.settings.post_success_content != blank %}
              <div class="form-message__title">{{ section.settings.post_success_content }}</div>
            {% endif %}
          </div>
        </div>
        <form method="post" action="/apps/raffle-form">
          {% if section.settings.klaviyo_list_id != blank %}
            <input type="hidden" name="klaviyo_list_id" value="{{ section.settings.klaviyo_list_id }}">
          {% endif %}
          {% if section.settings.google_sheet_id != blank %}
            <input type="hidden" name="google_sheet_id" value="{{ section.settings.google_sheet_id }}">
          {% endif %}
          {% if section.settings.google_sheet_name != blank %}
            <input type="hidden" name="google_sheet_name" value="{{ section.settings.google_sheet_name }}">
          {% endif %}
          <div class="contact-form__wrapper">
            <div class="contact-form__form">
              <div id="ContactForm" class="form-vertical">
                {% content_for 'blocks' %}
              </div>

              <div class="raffle-form__error-message hidden">
                <h4 class="raffle-form__error-message-text">Fehler: Es gab Probleme bei der Übermittlung der Daten.</h4>
              </div>

              <div class="contact-form__button-wrapper button-position--{{ section.settings.button_position }}">
                <button type="submit" class="button contact-form__button" disabled>
                  {{ section.settings.button_text }}
                </button>
              </div>
            </div>
          </div>
        </form>
      </raffle-form>
    </div>
  </div>

  <div class="base-triangular-line">
    {%- render 'icon-triangular-line' -%}
  </div>
</section>

{% stylesheet %}
  .raffle-form .group label,
  .raffle-form .group .raffle-input {
    width: 100%;
  }

  .raffle-form .contact-form__checkbox {
    margin-top: 12px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Raffle form",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Contact us"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>We're here to help you</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Anfrage senden"
    },
    {
      "type": "select",
      "id": "button_position",
      "label": "Button position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "App destinations"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo List ID",
      "info": "Die List-ID der Newsletter-Liste."
    },
    {
      "type": "text",
      "id": "google_sheet_id",
      "label": "Google Sheet ID",
      "info": "The spreadsheet ID from the sheet URL."
    },
    {
      "type": "text",
      "id": "google_sheet_name",
      "label": "Google Sheet tab name",
      "info": "The tab name inside the spreadsheet (e.g. Sheet1)."
    },
    {
      "type": "header",
      "content": "Success message"
    },
    {
      "type": "text",
      "id": "post_success_title",
      "label": "Post success title",
      "default": "Danke für deine Teilnahme!"
    },
    {
      "type": "richtext",
      "id": "post_success_content",
      "label": "Post success content",
      "default": "<p>Du bist jetzt im Lostopf!</p>"
    },
    {
      "type": "text",
      "id": "post_success_anchor",
      "label": "Post success anchor",
      "info": "Input an ID of an element, the window will scroll to the element when the form is submitted successfully"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#5359e5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2ac2bd"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover Color",
      "default": "#f3587f"
    }
  ],
  "blocks": [
    { "type": "group" },
    { "type": "raffle-input" },
    { "type": "raffle-select" },
    { "type": "raffle-question" },
    { "type": "file-upload" },
    { "type": "raffle-consent" }
  ],
  "presets": [
    {
      "name": "Raffle form",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "display_type": "grid",
            "direction": "row",
            "alignment": "flex-start",
            "gap": 20,
            "child_width": "1fr 1fr 1fr",
            "margin_bottom": 20
          },
          "blocks": [
            {
              "type": "raffle-select",
              "settings": {
                "label": "Anrede",
                "field_name": "Anrede",
                "required": true
              },
              "blocks": [
                { "type": "_option", "settings": { "label": "Frau" } },
                { "type": "_option", "settings": { "label": "Herr" } },
                { "type": "_option", "settings": { "label": "Keine Angabe" } }
              ]
            },
            {
              "type": "raffle-input",
              "settings": {
                "type": "text",
                "label": "Vorname",
                "placeholder": "Vorname",
                "field_name": "Vorname",
                "required": true
              }
            },
            {
              "type": "raffle-input",
              "settings": {
                "type": "text",
                "label": "Nachname",
                "placeholder": "Nachname",
                "field_name": "Nachname",
                "required": true
              }
            }
          ]
        },
        {
          "type": "raffle-input",
          "settings": {
            "type": "email",
            "label": "E-Mail",
            "placeholder": "E-Mail",
            "field_name": "E-Mail",
            "autocomplete": "email",
            "required": true
          }
        },
        {
          "type": "group",
          "settings": {
            "display_type": "grid",
            "direction": "row",
            "alignment": "flex-start",
            "gap": 20,
            "child_width": "1fr 1fr 1fr",
            "margin_bottom": 20
          },
          "blocks": [
            {
              "type": "raffle-input",
              "settings": {
                "type": "text",
                "label": "Straße & Hausnummer",
                "placeholder": "Straße & Hausnummer",
                "field_name": "Straße & Hausnummer",
                "autocomplete": "street-address",
                "required": true
              }
            },
            {
              "type": "raffle-input",
              "settings": {
                "type": "text",
                "label": "PLZ",
                "placeholder": "PLZ",
                "field_name": "PLZ",
                "autocomplete": "postal-code",
                "required": true
              }
            },
            {
              "type": "raffle-input",
              "settings": {
                "type": "text",
                "label": "Ort",
                "placeholder": "Ort",
                "field_name": "Ort",
                "autocomplete": "address-level2",
                "required": true
              }
            }
          ]
        },
        {
          "type": "file-upload",
          "settings": {
            "label": "Kassenbon",
            "field_name": "Kassenbon",
            "required": true
          }
        },
        {
          "type": "raffle-question",
          "settings": {
            "title": "1. Kennst du treatfuls bereits?",
            "field_name": "Frage 1",
            "input_type": "radio",
            "required": true,
            "error_message": "Bitte wähle eine Antwort."
          },
          "blocks": [
            { "type": "_raffle-answer", "settings": { "label": "Nein, heute zum ersten Mal gesehen" } },
            { "type": "_raffle-answer", "settings": { "label": "Ja, aus dem Handel" } },
            { "type": "_raffle-answer", "settings": { "label": "Ja, von Social Media (Instagram, Pinterest, TikTok)" } },
            { "type": "_raffle-answer", "settings": { "label": "Ja, von Influencern" } },
            { "type": "_raffle-answer", "settings": { "label": "Ja, von Google / Online" } },
            { "type": "_raffle-answer", "settings": { "label": "Ja, aus Cafés, Sportstudios" } }
          ]
        },
        {
          "type": "raffle-question",
          "settings": {
            "title": "2. Worauf achtest du beim Kauf eines Snacks / Riegels am meisten? (Mehrfachauswahl möglich)",
            "field_name": "Frage 2",
            "input_type": "checkbox",
            "required": true,
            "error_message": "Bitte wähle mindestens eine Option oder trage etwas bei „Anderes“ ein.",
            "allow_other": true,
            "other_placeholder": "Anderes"
          },
          "blocks": [
            { "type": "_raffle-answer", "settings": { "label": "Wenig / kein Industriezucker" } },
            { "type": "_raffle-answer", "settings": { "label": "Natürliche Zutaten" } },
            { "type": "_raffle-answer", "settings": { "label": "Ballaststoffe / Nährwerte" } },
            { "type": "_raffle-answer", "settings": { "label": "Geschmackssorten, die mich ansprechen" } },
            { "type": "_raffle-answer", "settings": { "label": "Markenauftritt / Verpackung" } },
            { "type": "_raffle-answer", "settings": { "label": "Preis" } },
            { "type": "_raffle-answer", "settings": { "label": "Bio / Nachhaltigkeit" } },
            { "type": "_raffle-answer", "settings": { "label": "Glutenfrei" } }
          ]
        },
        {
          "type": "raffle-input",
          "settings": {
            "type": "textarea",
            "label": "3. Was hat dich überzeugt treatfuls zu kaufen?",
            "placeholder": "Was hat dich überzeugt treatfuls zu kaufen?",
            "field_name": "Frage 3",
            "required": false
          }
        },
        {
          "type": "raffle-consent",
          "settings": {
            "label": "* Ich habe die {terms} und die {privacy} gelesen und bin damit einverstanden, dass meine Daten zur Durchführung des Gewinnspiels verarbeitet werden.",
            "field_name": "AGB Akzeptiert",
            "required": true,
            "checked": false
          }
        },
        {
          "type": "raffle-consent",
          "settings": {
            "label": "Ich möchte per E-Mail über Neuigkeiten, Angebote und Aktionen von treatfuls informiert werden. Meine Einwilligung kann ich jederzeit widerrufen.",
            "field_name": "Newsletter Akzeptiert",
            "required": false,
            "checked": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
