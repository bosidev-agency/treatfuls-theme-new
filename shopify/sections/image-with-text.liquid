<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background_color != 'rgba(0,0,0,0)' and section.settings.background_color != blank -%}
      --section-background-color: {{ section.settings.background_color }};
    {%- endif -%}
    {%- if section.settings.accent_color != 'rgba(0,0,0,0)' and section.settings.accent_color != blank -%}
      --section-accent-color: {{ section.settings.accent_color }};
    {%- endif -%}
    {%- if section.settings.hover_color != 'rgba(0,0,0,0)' and section.settings.hover_color != blank -%}
      --section-hover-color: {{ section.settings.hover_color }};
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .content-wrapper {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .image-with-text__image--has-badge {
    position: relative;
  }
  /* Badge: circle size and logo size are controlled independently */
  #shopify-section-{{ section.id }} .iwt-badge {
    --iwt-scale: 1;
    width: calc(var(--iwt-circle-size, 110px) * var(--iwt-scale));
    height: calc(var(--iwt-circle-size, 110px) * var(--iwt-scale));
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    flex-shrink: 0;
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .iwt-badge--no-circle {
    width: calc(var(--iwt-logo-size, 75px) * var(--iwt-scale));
    height: calc(var(--iwt-logo-size, 75px) * var(--iwt-scale));
    background: transparent;
    box-shadow: none;
    border-radius: 0;
  }
  #shopify-section-{{ section.id }} .iwt-badge a {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .iwt-badge img {
    width: calc(var(--iwt-logo-size, 75px) * var(--iwt-scale));
    height: calc(var(--iwt-logo-size, 75px) * var(--iwt-scale));
    max-width: none;
    object-fit: contain;
    display: block;
  }
  #shopify-section-{{ section.id }} .iwt-badge--image {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    transform: rotate(-8deg);
  }
  #shopify-section-{{ section.id }} .iwt-badge--title {
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .iwt-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .iwt-badge {
      --iwt-scale: 0.75;
    }
  }
</style>

<section
	class="image-with-text"
	data-section-id="{{- section.id -}}"
	data-section-type="image-with-text"
>
	<div class="content-wrapper">
    <div class="container">
      <div class="image-with-text__items">
        {% for block in section.blocks %}
          {%- liquid
            assign badge_position = block.settings.badge_position | default: 'image'
            assign badge_logo_size = block.settings.badge_logo_size | default: 75
            assign badge_circle_class = ''
            if block.settings.badge_show_circle == false
              assign badge_circle_class = ' iwt-badge--no-circle'
            endif
            assign badge_html = ''
            if block.settings.badge_image != blank
              assign badge_alt = block.settings.badge_alt | default: block.settings.badge_image.alt
              capture badge_img
                echo block.settings.badge_image | image_url: width: 400 | image_tag: alt: badge_alt, loading: 'lazy'
              endcapture
              capture badge_html
                echo '<div class="iwt-badge iwt-badge--' | append: badge_position | append: badge_circle_class | append: '" style="--iwt-circle-size: ' | append: block.settings.badge_size | append: 'px; --iwt-logo-size: ' | append: badge_logo_size | append: 'px;">'
                if block.settings.badge_url != blank
                  echo '<a href="' | append: block.settings.badge_url | append: '" aria-label="' | append: badge_alt | append: '">'
                  echo badge_img
                  echo '</a>'
                else
                  echo badge_img
                endif
                echo '</div>'
              endcapture
            endif
          -%}
          <div class="image-with-text__wrapper {% if block.settings.image_position == 'right' %}image-with-text__wrapper--reverse{% endif %}">
            <div class="image-with-text__image{% if badge_html != blank and badge_position == 'image' %} image-with-text__image--has-badge{% endif %}">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'image-with-text__image-image' }}
              {% endif %}
              {% if badge_html != blank and badge_position == 'image' %}{{ badge_html }}{% endif %}
            </div>
            <div class="image-with-text__content">
              <div class="image-with-text__text-content">
                {% if badge_html != blank and badge_position == 'title' %}{{ badge_html }}{% endif %}
                {% if block.settings.title != blank %}
                  <h2 class="image-with-text__title title-bg">{{ block.settings.title }}</h2>
                {% endif %}
                {% if block.settings.content != blank %}
                  <div class="image-with-text__content-text">
                    {{ block.settings.content }}
                  </div>
                {% endif %}
              </div>
              {% if badge_html != blank and badge_position == 'button' %}
                <div class="iwt-actions">
                  {% if block.settings.button_text != blank %}
                    <a href="{{ block.settings.button_url }}" class="button">{{ block.settings.button_text }}</a>
                  {% endif %}
                  {{ badge_html }}
                </div>
              {% elsif block.settings.button_text != blank %}
                <a href="{{ block.settings.button_url }}" class="button">{{ block.settings.button_text }}</a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="base-triangular-line">
		{%- render 'icon-triangular-line' -%}
	</div>
</section>

{% schema %}
{
	"name": "Image with text",
	"settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover Color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 80,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 5
    }
	],
  "blocks": [
    {
      "type": "image_with_text",
      "name": "Image with text",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Content</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Button Text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "header",
          "content": "Badge / Logo"
        },
        {
          "type": "image_picker",
          "id": "badge_image",
          "label": "Badge image",
          "info": "Optional, e.g. retailer logo. Transparent PNG or SVG recommended."
        },
        {
          "type": "select",
          "id": "badge_position",
          "label": "Badge position",
          "options": [
            {
              "value": "image",
              "label": "On image (corner)"
            },
            {
              "value": "title",
              "label": "Above title"
            },
            {
              "value": "button",
              "label": "Next to button"
            }
          ],
          "default": "image"
        },
        {
          "type": "range",
          "id": "badge_logo_size",
          "label": "Logo size",
          "min": 30,
          "max": 200,
          "step": 5,
          "unit": "px",
          "default": 75
        },
        {
          "type": "checkbox",
          "id": "badge_show_circle",
          "label": "Show white circle behind logo",
          "default": true
        },
        {
          "type": "range",
          "id": "badge_size",
          "label": "Circle size",
          "info": "Only used when the white circle is shown.",
          "min": 60,
          "max": 200,
          "step": 10,
          "unit": "px",
          "default": 110
        },
        {
          "type": "text",
          "id": "badge_alt",
          "label": "Badge alt text",
          "default": "Erhältlich bei dm"
        },
        {
          "type": "url",
          "id": "badge_url",
          "label": "Badge link (optional)"
        }
      ]
    }
  ],
	"presets": [
		{
			"name": "Image with text"
		}
	]
}
{% endschema %}
